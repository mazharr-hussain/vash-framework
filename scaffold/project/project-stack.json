{
  "schema_version": "1.0",
  "project": {
    "id": "new-project",
    "name": "New Project",
    "repository": "owner/new-project",
    "visibility": "private"
  },
  "vash": {
    "version": "3.0.0",
    "commit": "to-verify"
  },
  "stack": {
    "pack": "design-only",
    "pack_version": "1.0.0",
    "platform_version": {}
  },
  "forge": {
    "choice": "github",
    "settings": {
      "repo": "owner/new-project"
    }
  },
  "ci": {
    "choice": "github-actions",
    "settings": {
      "repo": "owner/new-project"
    }
  },
  "cloud": {
    "choice": "none",
    "settings": {}
  },
  "agents": [],
  "skills": [],
  "tools": [],
  "paths": {
    "allowed_write": [
      "src/**",
      "database/**"
    ]
  },
  "models": {
    "routes": {
      "local": {
        "adapter": "ollama",
        "model": "qwen2.5-coder:7b",
        "vendor": "local",
        "timeout_s": 600
      },
      "coding": {
        "adapter": "litellm",
        "model": "vash-coding",
        "vendor": "gateway-coding",
        "timeout_s": 600
      },
      "review": {
        "adapter": "litellm",
        "model": "vash-review",
        "vendor": "gateway-review",
        "timeout_s": 600
      },
      "docs": {
        "adapter": "litellm",
        "model": "vash-docs",
        "vendor": "gateway-docs",
        "timeout_s": 600
      },
      "prompt": {
        "adapter": "litellm",
        "model": "vash-prompt",
        "vendor": "gateway-prompt",
        "timeout_s": 600
      },
      "test": {
        "adapter": "litellm",
        "model": "vash-test",
        "vendor": "gateway-test",
        "timeout_s": 600
      }
    },
    "intake": "local",
    "coder": "coding",
    "critic": "review",
    "fallback": "local",
    "by_type": {
      "code": {
        "coder": "coding",
        "critic": "review"
      },
      "test": {
        "coder": "test",
        "critic": "review"
      },
      "artifact": {
        "coder": "docs",
        "critic": "review"
      },
      "feature": {
        "coder": "docs",
        "critic": "review"
      },
      "manual_step": {
        "coder": "docs",
        "critic": "review"
      },
      "prompt": {
        "coder": "prompt",
        "critic": "review"
      }
    }
  },
  "thresholds": {
    "code": 90,
    "artifact": 88,
    "feature": 88
  },
  "floor": 88
}
